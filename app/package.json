{
  "name": "itsc-3155-project",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "api": "node server.mjs",
    "db:seed": "node seed.mjs",
    "db:generate": "prisma generate --schema ../prisma/schema.prisma",
    "db:validate": "prisma validate --schema ../prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema ../prisma/schema.prisma",
    "db:deploy": "prisma migrate deploy --schema ../prisma/schema.prisma"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.7.0",
    "@prisma/client": "^6.19.0",
    "dotenv": "^16.4.7",
    "prisma": "^6.19.0",
    "typescript": "~5.8.3",
    "vite": "^6.3.5"
  }
}
